[
  {
    "id": "npc-qixia-elder",
    "isNew": false,
    "merchant": false,
    "name": "村长",
    "portraitData": "/public/assets/images/editor/npcs/npc-qixia-elder-portraitData.webp",
    "avatarData": "/public/assets/images/editor/npcs/npc-qixia-elder-imageData.webp",
    "mapPortraitData": "",
    "imageData": "/public/assets/images/editor/npcs/npc-qixia-elder-imageData.webp",
    "dialogue": [
      "……"
    ],
    "dialogueTree": {
      "startId": "elder-start",
      "nodes": [
        {
          "id": "elder-start",
          "text": "村长：昨夜子时，青云山方向忽然亮起一道青白异光，村外的灵兽都躁动不安。\n村长：我担心山中封存的古物出了变故。你若有空，可愿替栖霞村前去查看？",
          "choices": [
            {
              "id": "elder-start-1",
              "text": "我愿意前往青云山。",
              "nextId": "elder-accept",
              "action": ""
            },
            {
              "id": "elder-start-2",
              "text": "那道异光具体出现在哪里？",
              "nextId": "elder-clue",
              "action": ""
            },
            {
              "id": "elder-start-3",
              "text": "我还需要准备，暂时告辞。",
              "nextId": "",
              "action": ""
            }
          ]
        },
        {
          "id": "elder-accept",
          "text": "村长：好，有你这句话，我便放心些。\n村长：沿村北小径向东走，见到三块石碑后便是青云山脚。山中雾气异常，切记不要贸然深入。",
          "choices": [
            {
              "id": "elder-accept-1",
              "text": "我现在就出发。",
              "nextId": "elder-task",
              "action": ""
            },
            {
              "id": "elder-accept-2",
              "text": "村长可还有别的提醒？",
              "nextId": "elder-clue",
              "action": ""
            },
            {
              "id": "elder-accept-3",
              "text": "我再准备一下。",
              "nextId": "",
              "action": ""
            }
          ]
        },
        {
          "id": "elder-clue",
          "text": "村长：异光最初出现在山脚的古潭附近。那里原本有一座残破石台，村中老人称它为“问道台”。\n村长：近几日还有人听见潭边传来玉石相击之声，但无人敢靠近。",
          "choices": [
            {
              "id": "elder-clue-1",
              "text": "我会去古潭查看。",
              "nextId": "elder-task",
              "action": ""
            },
            {
              "id": "elder-clue-2",
              "text": "这件事和村子有什么关系？",
              "nextId": "elder-worry",
              "action": ""
            },
            {
              "id": "elder-clue-3",
              "text": "我还需要准备。",
              "nextId": "",
              "action": ""
            }
          ]
        },
        {
          "id": "elder-worry",
          "text": "村长：栖霞村靠青云山而生。若山中灵气失衡，田地、溪流，甚至村民都会受到影响。\n村长：我不求你冒险，只希望你替我们确认异象的根源。",
          "choices": [
            {
              "id": "elder-worry-1",
              "text": "我明白了，我会去调查。",
              "nextId": "elder-task",
              "action": ""
            },
            {
              "id": "elder-worry-2",
              "text": "我暂时无法答应。",
              "nextId": "",
              "action": ""
            }
          ]
        },
        {
          "id": "elder-task",
          "text": "村长：多谢。此事就拜托你了。\n村长：前往青云山脚，调查古潭与问道台附近的异常玉光。若遇危险，先保全自己。",
          "choices": [
            {
              "id": "elder-task-1",
              "text": "我记下了。",
              "nextId": "",
              "action": ""
            }
          ]
        }
      ]
    },
